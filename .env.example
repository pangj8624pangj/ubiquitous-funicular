# ── API server (api/) ──────────────────────────────────────────────────────────

# Port the Express API listens on (Vite proxies /api → this port in dev)
PORT=3001

# Secret used to sign JWTs. MUST be changed in production — use a long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-CHANGE-IN-PRODUCTION

# Absolute path to the SQLite database file (defaults to api/data/pulseops.db)
# DATABASE_PATH=/var/data/pulseops.db

# Production: swap SQLite for Postgres by setting this and updating api/src/db.ts
# DATABASE_URL=postgresql://user:pass@host:5432/pulseops

# Production: Redis for caching and pub/sub (swap MemoryCache in api/src/services/cache.ts)
# REDIS_URL=redis://localhost:6379

# URL that the Vite dev server (or deployed frontend) is served on.
# Used for CORS and OAuth redirect targets.
FRONTEND_URL=http://localhost:5173

# ── Intercom OAuth (optional — enables the OAuth flow in the setup wizard) ──────

# Register an OAuth app at https://app.intercom.com/a/apps/_/developer-hub
# Set the Redirect URL to: https://yourdomain.com/api/intercom/oauth/callback
# INTERCOM_CLIENT_ID=your_client_id
# INTERCOM_CLIENT_SECRET=your_client_secret
# OAUTH_REDIRECT_URI=https://yourdomain.com/api/intercom/oauth/callback

# ── Intercom Webhooks (optional — enables real-time SSE push instead of polling) ──
# Set the webhook URL in the Intercom Developer Hub to:
#   https://yourdomain.com/api/webhooks/intercom
# Copy the "Secret Key" shown by Intercom and paste below.
# INTERCOM_WEBHOOK_SECRET=your_webhook_secret

# ── Frontend (src/) ─────────────────────────────────────────────────────────────

# Base URL for API calls. Empty in dev (Vite proxies /api → localhost:3001).
# In production set this to your deployed API URL.
# VITE_API_URL=https://api.yourdomain.com

# Set this to enable the OAuth button in the Intercom setup wizard.
# Must match INTERCOM_CLIENT_ID above.
# VITE_INTERCOM_CLIENT_ID=your_client_id
